# ======================
# Database (Cloudflare D1)
# ======================
# Local development uses SQLite, production uses Cloudflare D1
DATABASE_URL="file:./dev.db"
D1_BINDING="AI_RESUME_DB"
# Create D1 database: wrangler d1 create AI_RESUME_DB
# Then add binding to wrangler.toml

# ======================
# NextAuth Configuration
# ======================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-generate-with-openssl"
# Generate secret: openssl rand -base64 32

# ======================
# AI Services (OpenRouter - Free DeepSeek)
# ======================
# OpenRouter provides free access to DeepSeek R1 model
OPENROUTER_API_KEY="your-openrouter-api-key"
OPENROUTER_MODEL="deepseek/deepseek-r1:free"
# Get your API key from: https://openrouter.ai/keys

# AI Provider Configuration
# Choose primary AI provider: 'openrouter', 'cloudflare', or 'dual'
AI_PROVIDER="openrouter"
# Enable automatic fallback to secondary provider when primary fails
AI_FALLBACK_ENABLED="true"

# ======================
# Cloudflare Account Configuration
# ======================
# Your Cloudflare account ID (required for all Cloudflare services)
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
# Get from: Cloudflare Dashboard → Account ID (right sidebar)

# Cloudflare API Token (required for deployments and API access)
CLOUDFLARE_API_TOKEN="your-cloudflare-api-token"
# Create token: Cloudflare Dashboard → My Profile → API Tokens
# Required permissions: Account.Cloudflare Pages (Edit), Account.Workers R2 Storage (Edit)

# ======================
# File Storage (Cloudflare R2)
# ======================
# S3-compatible storage for resumes, profile images, etc.
R2_BUCKET_NAME="ai-resume-storage"
R2_BINDING="RESUME_BUCKET"
# Public URL for R2 bucket (optional, for direct file access)
R2_PUBLIC_URL="https://pub-your-account-id.r2.dev"
# Create bucket: wrangler r2 bucket create ai-resume-storage
# Note: R2 credentials are managed through wrangler.toml bindings in production
# For local development, wrangler dev will use local storage

# ======================
# Cache / Session Store (Cloudflare KV)
# ======================
# Replaces Redis with Cloudflare KV for job queues and caching
KV_NAMESPACE_ID="your-kv-namespace-id"
KV_BINDING="RESUME_CACHE"
# Create namespace: wrangler kv:namespace create RESUME_CACHE
# Get namespace ID from output and add to wrangler.toml
# For local development: wrangler kv:namespace create RESUME_CACHE --preview

# ======================
# Database (Cloudflare D1)
# ======================
# D1 database ID (from wrangler d1 create command)
D1_DATABASE_ID="your-d1-database-id"
D1_DATABASE_NAME="ai-resume-db"
D1_BINDING="DB"
# Create database: wrangler d1 create ai-resume-db
# Get database ID from output and add to wrangler.toml
# Local development uses SQLite file: .wrangler/state/v3/d1/miniflare-D1DatabaseObject/

# ======================
# Durable Objects (Job Queue)
# ======================
# Durable Objects namespace for job processing
DO_JOB_QUEUE_BINDING="JOB_QUEUE"
DO_JOB_QUEUE_CLASS="JobQueueDO"
# Durable Objects are configured in wrangler.toml
# No additional environment variables needed

# ======================
# Cloudflare AI (Optional Hybrid)
# ======================
# Use Cloudflare's free AI inference models at the edge (optional)
WORKERS_AI_BINDING="AI"
WORKERS_AI_MODEL="@cf/meta/llama-3-8b-instruct"
# Enable Cloudflare AI fallback (true/false)
ENABLE_CLOUDFLARE_AI="false"
# Cloudflare AI is available through Workers AI binding in wrangler.toml

# ======================
# GitHub Integration
# ======================
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
GITHUB_REDIRECT_URI="http://localhost:3000/api/auth/callback/github"
GITHUB_TOKEN="your-github-personal-access-token"
# Create OAuth App: https://github.com/settings/developers
# Create PAT: https://github.com/settings/tokens

# ======================
# LinkedIn Integration
# ======================
LINKEDIN_CLIENT_ID="your-linkedin-client-id"
LINKEDIN_CLIENT_SECRET="your-linkedin-client-secret"
LINKEDIN_REDIRECT_URI="http://localhost:3000/api/auth/callback/linkedin"
# Create app: https://www.linkedin.com/developers/apps

# ======================
# Application Settings
# ======================
NODE_ENV="development"
PORT="3000"

# ======================
# Deployment (Cloudflare Pages)
# ======================
# Deploy with: npx wrangler pages deploy
CLOUDFLARE_PAGES_PROJECT="ai-resume-portfolio"
VERCEL_TOKEN="your-vercel-token"
NETLIFY_TOKEN="your-netlify-token"

# ======================
# Data Migration Settings
# ======================
# These variables are only needed during migration from AWS/Redis to Cloudflare

# AWS S3 Configuration (for migration only)
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="us-east-1"
S3_BUCKET_NAME="your-s3-bucket-name"

# PostgreSQL Configuration (for migration only)
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_DB="your-database-name"
POSTGRES_USER="your-username"
POSTGRES_PASSWORD="your-password"

# Redis Configuration (for migration only)
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD="your-redis-password"
REDIS_DB="0"

# R2 API Credentials (for migration only - different from R2 binding)
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"
# Generate R2 API tokens: Cloudflare Dashboard → R2 → Manage R2 API Tokens

# Migration Script Settings
PARALLEL_TRANSFERS="5"          # Number of parallel file transfers for S3→R2
BATCH_SIZE="100"                # Batch size for PostgreSQL→D1 imports
VERIFY_CHECKSUMS="true"         # Verify file checksums during S3→R2 migration
VERIFY_DATA="true"              # Verify data integrity after PostgreSQL→D1 migration
VERIFY_JOBS="true"              # Verify jobs after Redis→KV migration
ROLLBACK_ON_ERROR="false"       # Automatically rollback on migration errors
WORKER_NAME="ai-resume-portfolio"  # Worker name for Durable Objects migration
